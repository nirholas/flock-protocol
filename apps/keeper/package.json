{
  "name": "@flock/keeper",
  "version": "0.1.0",
  "description": "Keeper for Flock indexes: accrues fees, closes expired auctions, and bids the ones that are worth bidding",
  "license": "MIT",
  "type": "module",
  "bin": { "flock-keeper": "./dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flock/sdk": "workspace:*",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
