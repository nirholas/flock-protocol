{
  "name": "flock-protocol",
  "private": true,
  "version": "0.1.0",
  "description": "Index engine for the Flock index cooperative on Solana",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "program:build": "cd program && cargo build-sbf",
    "program:test": "cd program && cargo test",
    "keeper": "pnpm --filter @flock/keeper start",
    "api": "pnpm --filter @flock/api start"
  }
}
